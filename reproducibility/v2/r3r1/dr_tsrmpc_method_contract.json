    "future_wind",
    "future_target",
    "holdout_information"
  ],
  "horizon": 20,
  "dt_s": 0.05,
  "physical_constraints": {
    "ax_abs_max_m_s2": 2.0,
    "ax_slew_max_m_s2_per_update": 0.25
  },
  "solver": {
    "name": "OSQP",
    "eps_abs": 1e-05,
    "eps_rel": 1e-05,
    "max_iter": 4000,
    "warm_start": true
  },
  "performance_executed": false
}
